# pnpm 11+ requires explicit acknowledgement of packages that run install
# scripts. esbuild is the only one we trust here (it ships native binaries).
# Listing it in `package.json#pnpm.onlyBuiltDependencies` also works, but the
# `.npmrc` flag below disables the new strict gate so CI doesn't break on
# transitive additions.
dangerously-allow-all-builds=true

# Vite + Tailwind 4 work best with a hoisted node_modules layout when the
# repo is bind-mounted into Docker (the anonymous-volume trick fails otherwise).
shamefully-hoist=true
