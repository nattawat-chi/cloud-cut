# Auto-normalise line endings to LF in the repo; checkout converts to host
# native (CRLF on Windows). Suppresses the "LF will be replaced by CRLF"
# warning we saw on the initial commit.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows or sh interpreters break.
*.sh   text eol=lf

# Lockfiles + minified output should never be eyeballed in diffs.
pnpm-lock.yaml   linguist-generated=true
Cargo.lock       linguist-generated=true
