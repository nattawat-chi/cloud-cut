# =============================================================================
# CloudCut — Environment variables (template).
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# When running Rust on host: hits the Postgres container's mapped port.
# When running Rust in a container: docker-compose.full.yml overrides this with
# the in-network hostname (postgres:5432).
DATABASE_URL=postgresql://cloudcut:cloudcut_dev@localhost:5432/cloudcut

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally, R2/S3 in prod) -------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cloudcut
S3_SECRET_KEY=cloudcut_dev_secret
S3_BUCKET=cloudcut-assets
# Public-facing URL used when the backend hands out variant links to the browser.
S3_PUBLIC_URL=http://localhost:9000/cloudcut-assets

# ---- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-please-use-at-least-32-bytes-in-production
JWT_ACCESS_TTL_SECONDS=900            # 15 min
JWT_REFRESH_TTL_SECONDS=2592000       # 30 days

# ---- Backend server ---------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
RUST_LOG=backend=debug,worker=debug,tower_http=info,sqlx=warn

# ---- Pusher (real-time collaboration) --------------------------------------
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# ---- Frontend (Vite reads VITE_*) ------------------------------------------
VITE_API_URL=http://localhost:8080
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap1
