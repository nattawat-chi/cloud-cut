# =============================================================================
# CloudCut — Environment variables (template).
# Copy to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# ---- Database ---------------------------------------------------------------
# When running Rust on host: hits the Postgres container's mapped port.
# When running Rust in a container: docker-compose.full.yml overrides this with
# the in-network hostname (postgres:5432).
DATABASE_URL=postgresql://cloudcut:cloudcut_dev@localhost:5432/cloudcut

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Object storage (MinIO locally, R2/S3 in prod) -------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cloudcut
S3_SECRET_KEY=cloudcut_dev_secret
S3_BUCKET=cloudcut-assets
S3_PRESIGN_EXPIRES_SECS=900             # 15 min PUT URL TTL
# Public-facing URL used when the backend hands out variant links to the browser.
S3_PUBLIC_URL=http://localhost:9000/cloudcut-assets

# ---- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-please-use-at-least-32-bytes-in-production
JWT_ACCESS_EXP_SECS=900                 # 15 min
JWT_REFRESH_EXP_SECS=604800             # 7 days

# ---- Backend server ---------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
RUST_LOG=backend=debug,worker=debug,tower_http=info,sqlx=warn

# ---- Worker tuning ----------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1000
WORKER_MAX_RETRIES=3
# Worker calls back to the backend for status updates (optional, currently unused)
BACKEND_URL=http://localhost:8080

# ---- Pusher (real-time collaboration) --------------------------------------
# Leave blank to disable real-time — frontend will use the scripted CollabSimulator.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1

# ---- Frontend (Vite reads VITE_*) ------------------------------------------
VITE_API_BASE=/api/v1
# Public S3/MinIO base URL — used by the frontend to load asset thumbnails and
# proxy.mp4 directly without round-tripping through the backend. Must match
# the bucket's anonymous-download path. Worker writes to variants/* using
# this same convention.
VITE_S3_PUBLIC_URL=http://localhost:9000/cloudcut-assets
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap1
# Optional: tag your editor session so remote-op echo can be suppressed locally.
VITE_USER_ID=
# Optional: JWT used by the Pusher channel-auth fetch — wired in by the
# login flow in production; export inline for local hacking.
VITE_AUTH_TOKEN=
# Set to "1" to enable verbose pusher-js console logs (dev only).
VITE_PUSHER_DEBUG=0
